<span class="status-pill @PillClass">@Status</span>

@code {
    [Parameter, EditorRequired]
    public required string Status { get; set; }

    private string PillClass => Status switch
    {
        "Applied" => "status-pill--applied",
        "Interviewing" => "status-pill--interviewing",
        "Offer" => "status-pill--offer",
        "Rejected" => "status-pill--rejected",
        "Withdrawn" => "status-pill--withdrawn",
        _ => "status-pill--unknown",
    };
}
