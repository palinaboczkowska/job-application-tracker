@page "/applications/{Id:int}"
@inject IJobApplicationApiClient Api
@inject NavigationManager Nav
@inject ILanguageService Lang
@implements IDisposable

<PageTitle>@(_application?.CompanyName ?? Lang.T("detail.pageTitleFallback"))</PageTitle>

@if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
    <a class="btn btn-link" href="/applications">@Lang.T("detail.backToList")</a>
}
else if (_application is null)
{
    <p><em>@Lang.T("common.loading")</em></p>
}
else
{
    <p>
        <a class="btn btn-outline-secondary btn-sm" href="/applications">@Lang.T("detail.backShort")</a>
    </p>

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1>@_application.RoleTitle</h1>
            <h5 class="text-muted">@_application.CompanyName</h5>
        </div>
        <StatusBadge Status="@_application.Status" />
    </div>

    <dl class="row">
        <dt class="col-sm-3">@Lang.T("detail.labelApplied")</dt>
        <dd class="col-sm-9">@_application.AppliedOn.ToString("yyyy-MM-dd")</dd>

        @if (!string.IsNullOrWhiteSpace(_application.JobPostingUrl))
        {
            <dt class="col-sm-3">@Lang.T("detail.labelPosting")</dt>
            <dd class="col-sm-9"><a href="@_application.JobPostingUrl" target="_blank" rel="noopener">@_application.JobPostingUrl</a></dd>
        }

        @if (!string.IsNullOrWhiteSpace(_application.Notes))
        {
            <dt class="col-sm-3">@Lang.T("detail.labelNotes")</dt>
            <dd class="col-sm-9">@_application.Notes</dd>
        }
    </dl>

    <div class="mb-4">
        <a class="btn btn-outline-secondary btn-sm" href="/applications/@Id/edit">@Lang.T("detail.edit")</a>

        @if (!_confirmingDelete)
        {
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmingDelete = true">@Lang.T("detail.delete")</button>
        }
        else
        {
            <span class="text-danger me-2">@Lang.T("detail.confirmDelete")</span>
            <button class="btn btn-danger btn-sm" @onclick="HandleDelete" disabled="@_deleting">@Lang.T("detail.confirmDeleteYes")</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmingDelete = false">@Lang.T("common.cancel")</button>
        }
    </div>

    <h4>@Lang.T("detail.changeStatusHeading")</h4>
    @if (_statusError is not null)
    {
        <div class="alert alert-warning">@_statusError</div>
    }
    <div class="btn-group mb-4" role="group">
        @foreach (var status in AllStatuses)
        {
            @if (status != _application.Status)
            {
                <button class="btn btn-outline-primary btn-sm" @onclick="() => HandleStatusChange(status)" disabled="@_changingStatus">
                    → @Lang.StatusLabel(status)
                </button>
            }
        }
    </div>

    @if (!_showCorrection)
    {
        <p>
            <button class="btn btn-link btn-sm text-muted p-0" @onclick="() => _showCorrection = true">
                @Lang.T("detail.correctionToggle")
            </button>
        </p>
    }
    else
    {
        <div class="card border-warning mb-4" style="max-width: 32rem;">
            <div class="card-body">
                <h6 class="card-title">@Lang.T("detail.correctionHeading")</h6>
                <p class="card-text text-muted small">
                    @Lang.T("detail.correctionDescription")
                </p>

                @if (_correctionError is not null)
                {
                    <div class="alert alert-warning py-1 px-2 small">@_correctionError</div>
                }

                <div class="mb-2">
                    <select class="form-select form-select-sm" @bind="_correctionStatus">
                        @foreach (var status in AllStatuses)
                        {
                            <option value="@status">@Lang.StatusLabel(status)</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <input class="form-control form-control-sm" placeholder="@Lang.T("detail.correctionNotePlaceholder")" @bind="_correctionNote" />
                </div>
                <button class="btn btn-warning btn-sm" @onclick="HandleCorrect" disabled="@_correcting">@Lang.T("detail.correctionSubmit")</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showCorrection = false">@Lang.T("common.cancel")</button>
            </div>
        </div>
    }

    <h4>@Lang.T("detail.historyHeading")</h4>
    @if (_history is null)
    {
        <p><em>@Lang.T("detail.historyLoading")</em></p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var change in _history)
            {
                <li class="list-group-item">
                    @(change.FromStatus is null ? Lang.T("detail.historyCreated") : Lang.StatusLabel(change.FromStatus)) → @Lang.StatusLabel(change.ToStatus)
                    <span class="text-muted">— @change.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    @if (change.IsCorrection)
                    {
                        <span class="tag-correction ms-1">@Lang.T("detail.historyCorrectionTag")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(change.Note))
                    {
                        <div class="text-muted fst-italic">@change.Note</div>
                    }
                </li>
            }
        </ul>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private static readonly string[] AllStatuses = { "Applied", "Interviewing", "Offer", "Rejected", "Withdrawn" };

    private JobApplicationDto? _application;
    private List<StatusChangeDto>? _history;
    private string? _loadError;
    private string? _statusError;
    private bool _changingStatus;
    private bool _confirmingDelete;
    private bool _deleting;

    private bool _showCorrection;
    private string _correctionStatus = "Applied";
    private string? _correctionNote;
    private string? _correctionError;
    private bool _correcting;

    protected override async Task OnInitializedAsync()
    {
        Lang.Changed += StateHasChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _application = await Api.GetByIdAsync(Id);
            if (_application is null)
            {
                _loadError = Lang.T("detail.notFound");
                return;
            }

            _history = await Api.GetStatusHistoryAsync(Id);
        }
        catch (Exception ex)
        {
            _loadError = Lang.T("detail.loadError", ex.Message);
        }
    }

    private async Task HandleStatusChange(string newStatus)
    {
        _changingStatus = true;
        _statusError = null;
        try
        {
            var result = await Api.ChangeStatusAsync(Id, new ChangeStatusRequest { NewStatus = newStatus });
            if (!result.Success)
            {
                _statusError = Lang.T("detail.statusChangeError", Lang.StatusLabel(newStatus));
            }
            else
            {
                _application = result.Application;
                _history = await Api.GetStatusHistoryAsync(Id);
            }
        }
        catch (Exception ex)
        {
            _statusError = Lang.T("detail.statusChangeGenericError", ex.Message);
        }
        finally
        {
            _changingStatus = false;
        }
    }

    private async Task HandleCorrect()
    {
        _correcting = true;
        _correctionError = null;
        try
        {
            var result = await Api.CorrectStatusAsync(Id, new ChangeStatusRequest
            {
                NewStatus = _correctionStatus,
                Note = string.IsNullOrWhiteSpace(_correctionNote) ? null : _correctionNote,
            });
            if (!result.Success)
            {
                _correctionError = Lang.T("detail.correctionError", Lang.StatusLabel(_correctionStatus));
            }
            else
            {
                _application = result.Application;
                _history = await Api.GetStatusHistoryAsync(Id);
                _showCorrection = false;
                _correctionNote = null;
            }
        }
        catch (Exception ex)
        {
            _correctionError = Lang.T("detail.correctionGenericError", ex.Message);
        }
        finally
        {
            _correcting = false;
        }
    }

    private async Task HandleDelete()
    {
        _deleting = true;
        try
        {
            await Api.DeleteAsync(Id);
            Nav.NavigateTo("/applications");
        }
        catch (Exception ex)
        {
            _loadError = Lang.T("detail.deleteError", ex.Message);
            _deleting = false;
        }
    }

    public void Dispose()
    {
        Lang.Changed -= StateHasChanged;
    }
}
