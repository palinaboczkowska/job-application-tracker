@page "/"
@page "/applications"
@inject IJobApplicationApiClient Api
@inject NavigationManager Nav
@inject ILanguageService Lang
@implements IDisposable

<PageTitle>@Lang.T("apps.pageTitle")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Lang.T("apps.heading")</h1>
    <a class="btn btn-primary" href="/applications/new">@Lang.T("apps.newButton")</a>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_applications is null)
{
    <p><em>@Lang.T("common.loading")</em></p>
}
else if (_applications.Count == 0)
{
    <p class="text-muted">@Lang.T("apps.empty")</p>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-sm-4">
            <input class="form-control form-control-sm" placeholder="@Lang.T("apps.filterCompany")" @bind="_companyFilter" @bind:event="oninput" />
        </div>
        <div class="col-sm-4">
            <input class="form-control form-control-sm" placeholder="@Lang.T("apps.filterRole")" @bind="_roleFilter" @bind:event="oninput" />
        </div>
        <div class="col-sm-4">
            <select class="form-select form-select-sm" @bind="_statusFilter">
                <option value="">@Lang.T("apps.filterAllStatuses")</option>
                @foreach (var status in AllStatuses)
                {
                    <option value="@status">@Lang.StatusLabel(status)</option>
                }
            </select>
        </div>
    </div>

    @if (FilteredApplications.Count == 0)
    {
        <p class="text-muted">@Lang.T("apps.filterEmpty")</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@Lang.T("apps.colCompany")</th>
                    <th>@Lang.T("apps.colRole")</th>
                    <th>@Lang.T("apps.colStatus")</th>
                    <th>@Lang.T("apps.colApplied")</th>
                    <th>@Lang.T("apps.colUpdated")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in FilteredApplications)
                {
                    <tr style="cursor:pointer" @onclick="() => GoToDetail(application.Id)">
                        <td>@application.CompanyName</td>
                        <td>@application.RoleTitle</td>
                        <td><StatusBadge Status="@application.Status" /></td>
                        <td>@application.AppliedOn.ToString("yyyy-MM-dd")</td>
                        <td>@application.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private static readonly string[] AllStatuses = { "Applied", "Interviewing", "Offer", "Rejected", "Withdrawn" };

    private List<JobApplicationDto>? _applications;
    private string? _loadError;

    private string _companyFilter = "";
    private string _roleFilter = "";
    private string _statusFilter = "";

    private List<JobApplicationDto> FilteredApplications =>
        (_applications ?? [])
            .Where(a => string.IsNullOrWhiteSpace(_companyFilter)
                || a.CompanyName.Contains(_companyFilter, StringComparison.OrdinalIgnoreCase))
            .Where(a => string.IsNullOrWhiteSpace(_roleFilter)
                || a.RoleTitle.Contains(_roleFilter, StringComparison.OrdinalIgnoreCase))
            .Where(a => string.IsNullOrWhiteSpace(_statusFilter) || a.Status == _statusFilter)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        Lang.Changed += StateHasChanged;

        try
        {
            _applications = await Api.GetAllAsync();
        }
        catch (Exception ex)
        {
            _loadError = Lang.T("apps.loadError", ex.Message);
        }
    }

    private void GoToDetail(int id) => Nav.NavigateTo($"/applications/{id}");

    public void Dispose()
    {
        Lang.Changed -= StateHasChanged;
    }
}
