@page "/not-found"
@layout MainLayout
@inject ILanguageService Lang
@implements IDisposable

<h3>@Lang.T("notfound.heading")</h3>
<p>@Lang.T("notfound.body")</p>

@code {
    protected override void OnInitialized()
    {
        Lang.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.Changed -= StateHasChanged;
    }
}
